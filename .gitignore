# ai-sdlc: local tooling stays local; only the audit trail ships.
# attestations/ + transcript-leaves/ + reviews/ are written AND COMMITTED by the
# pre-push signing hook - ignoring them breaks `git push` (NAD-004 hit this).
.ai-sdlc/*
!.ai-sdlc/attestations/
!.ai-sdlc/transcript-leaves/
!.ai-sdlc/reviews/
!.ai-sdlc/trusted-reviewers.yaml

