# Non-secret identifiers / URLs may be committed as environment configuration.
# Secrets must be injected by the runtime secret store.

N8N_HOST=n8n-staging.example.internal
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_EDITOR_BASE_URL=https://n8n-staging.example.internal/
WEBHOOK_URL=https://n8n-staging.example.internal/
N8N_ENCRYPTION_KEY=__INJECT_AT_RUNTIME__

SUPABASE_URL=https://staging-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__INJECT_AT_RUNTIME__

WOOCOMMERCE_BASE_URL=https://staging-shop.example.com
WOOCOMMERCE_CONSUMER_KEY=__INJECT_AT_RUNTIME__
WOOCOMMERCE_CONSUMER_SECRET=__INJECT_AT_RUNTIME__

META_GRAPH_BASE_URL=https://graph.facebook.com
META_PAGE_ID=__INJECT_AT_RUNTIME__
META_APP_SECRET=__INJECT_AT_RUNTIME__
META_VERIFY_TOKEN=__INJECT_AT_RUNTIME__
META_PAGE_ACCESS_TOKEN=__INJECT_AT_RUNTIME__

OPENAI_API_KEY=__INJECT_AT_RUNTIME__
OPENAI_MODEL=__PINNED_AT_DEPLOYMENT__

REDIS_URL=redis://redis:6379
