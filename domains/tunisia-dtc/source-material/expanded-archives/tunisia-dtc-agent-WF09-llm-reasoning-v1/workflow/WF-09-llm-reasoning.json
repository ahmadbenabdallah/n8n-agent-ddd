    {
      "parameters": {
        "jsCode": "const s=$json.security||{}; const safe=s.safe_to_reply!==false && s.security_decision!=='block'; const allowed=s.llm_allowed!==false; return [{json:{...$json,safe_for_llm:safe,llm_allowed_by_security:allowed}}];"
      },
      "id": "5",
