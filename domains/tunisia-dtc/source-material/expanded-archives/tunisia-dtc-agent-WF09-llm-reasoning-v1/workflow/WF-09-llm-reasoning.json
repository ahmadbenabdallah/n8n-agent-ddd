        "jsCode": "const i=$json; const required=['message_id','conversation_id','text','intent','route','identity','state','security']; const missing=required.filter(k=>i[k]===undefined); return [{json:{...i,input_valid:missing.length===0,missing_fields:missing}}];"
      },
