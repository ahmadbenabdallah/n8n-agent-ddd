      "id": "c2739624bcb341fd916aa35318f79353",
      "name": "Woo Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        900,
        700
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$json;\nconst op=$input.first().json.operation || x.operation || 'unknown';\nconst raw=x;\nlet result={success:true, operation:op, correlation_id:$execution.id};\nif(op==='create_cod_order'){\n  result.resource_type='order';\n  result.order={\n    id: raw.id,\n    number: raw.number,\n    status: raw.status,\n    currency: raw.currency,\n    total: raw.total,\n    payment_method: raw.payment_method,\n    payment_method_title: raw.payment_method_title,\n    date_created: raw.date_created,\n    line_items:(raw.line_items||[]).map(i=>({\n      id:i.id, product_id:i.product_id, variation_id:i.variation_id,\n      name:i.name, quantity:i.quantity, total:i.total\n    }))\n  };\n  result.verified_execution = Number.isInteger(raw.id) && !!raw.number;\n} else if(op==='get_order'){\n  result.order={\n    id:raw.id, number:raw.number, status:raw.status, currency:raw.currency,\n    total:raw.total, date_created:raw.date_created,\n    line_items:(raw.line_items||[]).map(i=>({\n      product_id:i.product_id, variation_id:i.variation_id,\n      name:i.name, quantity:i.quantity, total:i.total\n    }))\n  };\n} else if(op==='get_product' || op==='get_variation'){\n  result.product={\n    id:raw.id, sku:raw.sku, name:raw.name,\n    type:raw.type, price:raw.price, regular_price:raw.regular_price,\n    sale_price:raw.sale_price, stock_status:raw.stock_status,\n    stock_quantity:raw.stock_quantity, manage_stock:raw.manage_stock,\n    in_stock:raw.in_stock, purchasable:raw.purchasable,\n    variations:raw.variations\n  };\n  result.verified_source='woocommerce';\n} else {\n  result.data=raw;\n}\nreturn [{json:result}];"
      },
      "id": "6dd4da5b6739898e31dcda1f8505cce6",
      "name": "Normalize Woo Result",
