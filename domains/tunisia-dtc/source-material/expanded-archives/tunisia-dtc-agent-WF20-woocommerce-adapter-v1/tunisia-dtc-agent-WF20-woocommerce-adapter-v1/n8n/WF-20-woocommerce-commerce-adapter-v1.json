      "parameters": {},
      "id": "b7d2747ea4a57088ab3c8b6b643603a2",
      "name": "WF20 Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$json;\nconst errors=[];\nif(!x || typeof x!=='object') errors.push('input_not_object');\nconst allowed=['get_product','get_variation','list_products','get_order','create_cod_order','health'];\nif(!allowed.includes(x.operation)) errors.push('unsupported_operation');\nif(['get_product','get_variation','get_order'].includes(x.operation) && !x.id) errors.push('missing_id');\nif(x.operation==='get_variation' && !x.product_id) errors.push('missing_product_id');\nif(x.operation==='create_cod_order'){\n  if(!x.idempotency_key) errors.push('missing_idempotency_key');\n  if(!Array.isArray(x.line_items) || !x.line_items.length) errors.push('missing_line_items');\n  if(!x.billing || !x.billing.first_name || !x.billing.phone) errors.push('missing_billing');\n  if(!x.billing.country) errors.push('missing_country');\n}\nreturn [{json:{...x, _valid:errors.length===0, validation_errors:errors}}];"
      },
      "id": "f4e58dbec53cbb49fae067ee68892d7d",
