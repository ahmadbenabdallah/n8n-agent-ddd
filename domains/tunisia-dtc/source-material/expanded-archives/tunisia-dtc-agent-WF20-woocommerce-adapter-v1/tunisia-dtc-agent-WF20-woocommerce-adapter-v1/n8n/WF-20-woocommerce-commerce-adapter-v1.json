    {
      "parameters": {
        "jsCode": "const x=$json;\nconst status=x.statusCode || x.status || 0;\nreturn [{json:{\n  success:false,\n  operation:x.operation || 'unknown',\n  error_code: status===401||status===403?'WOOCOMMERCE_AUTHORIZATION_ERROR':\n             status===404?'WOOCOMMERCE_NOT_FOUND':\n             status>=500?'WOOCOMMERCE_SERVER_ERROR':'WOOCOMMERCE_API_ERROR',\n  customer_safe_message:'The commerce system could not confirm that request right now.',\n  correlation_id:$execution.id\n}}];"
      },
