    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.WOOCOMMERCE_BASE_URL + '/wp-json/wc/v3/orders'}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{JSON.stringify({\n  payment_method: $env.WOOCOMMERCE_COD_PAYMENT_METHOD || 'cod',\n  payment_method_title: $env.WOOCOMMERCE_COD_PAYMENT_TITLE || 'Cash on Delivery',\n  set_paid: false,\n  status: $env.WOOCOMMERCE_INITIAL_COD_STATUS || 'processing',\n  billing: $json.billing,\n  shipping: $json.shipping || $json.billing,\n  line_items: $json.line_items.map(i => ({\n    product_id: Number(i.product_id),\n    ...(i.variation_id ? {variation_id:Number(i.variation_id)} : {}),\n    quantity: Number(i.quantity)\n  })),\n  customer_note: $json.customer_note || '',\n  created_via: 'tunisia-dtc-agent',\n  meta_data: [\n    {key:'_dtc_agent_idempotency_key', value:$json.idempotency_key},\n    {key:'_dtc_agent_channel', value:$json.channel || 'messenger'},\n    {key:'_dtc_agent_conversation_id', value:$json.conversation_id || ''}\n  ]\n})}}"
      },
