      "parameters": {
        "jsCode": "const x=$json;\nif (x.commerce_status==='unavailable' && x.execution_allowed===false) {\n  return [{json:{...x, normalized:true}}];\n}\n// Preserve gateway metadata while normalizing adapter payloads.\nreturn [{json:{...x, normalized:true}}];"
