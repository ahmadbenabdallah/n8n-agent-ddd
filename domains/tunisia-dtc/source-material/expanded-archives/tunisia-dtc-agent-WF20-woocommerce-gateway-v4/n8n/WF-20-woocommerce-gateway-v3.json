    {
      "parameters": {
        "jsCode": "const x=$json;\nconst op=x.gateway_operation;\nconst isHealth=op==='health';\n\n// Health response can be a normal WC payload or an n8n error-shaped item when\n// the HTTP node is configured to continue on error. Treat only a successful\n// HTTP response as commerce-connected.\nconst httpStatus = Number(x.statusCode ?? x.status ?? 0);\nconst healthBody = x.body ?? x.data ?? x;\nconst looksLikeWcApi = !!healthBody && (\n  typeof healthBody==='object' || typeof healthBody==='string'\n);\nconst connected = isHealth ? null : (httpStatus>=200 && httpStatus<500 && looksLikeWcApi && !x.error);\n\nif (isHealth) {\n  return [{json:{...x, commerce_status: connected===null ? 'health_check' : (connected?'connected':'unavailable'), source_of_truth: connected===null ? 'woocommerce' : (connected?'woocommerce':'kb_only')}}];\n}\n\nconst readOnlyProductOps=['get_product','get_products','get_variation'];\nconst kbFallbackAllowed=readOnlyProductOps.includes(op);\nconst transactionalOps=!kbFallbackAllowed;\n\nif (!connected) {\n  return [{json:{\n    ...x,\n    success: false,\n    commerce_status: 'unavailable',\n    source_of_truth: kbFallbackAllowed ? 'kb_only' : 'none',\n    kb_fallback_allowed: kbFallbackAllowed,\n    execution_allowed: false,\n    error_code: transactionalOps ? 'woocommerce_unavailable_transaction_blocked' : 'woocommerce_unavailable_kb_fallback_allowed',\n    error_message: transactionalOps\n      ? 'WooCommerce is unavailable; transactional commerce operation is blocked.'\n      : 'WooCommerce is unavailable; caller may fall back to KB for informational product facts.',\n    verified_gateway: false\n  }}];\n}\n\nreturn [{json:{...x, commerce_status:'connected', source_of_truth:'woocommerce', kb_fallback_allowed:false, execution_allowed: true}}];"
      },
