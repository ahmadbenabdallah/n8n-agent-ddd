    {
      "parameters": {
        "jsCode": "const raw=$json;\nconst result=raw.commerce_result ?? raw.result ?? raw.data ?? raw;\nconst orders=Array.isArray(result.orders)?result.orders:(Array.isArray(result)?result:[]);\nconst order=result.order && typeof result.order==='object'?result.order:(orders[0]||null);\nreturn [{json:{...raw,woo_order:order,woo_orders:orders,commerce_verified_source:result.verified_source===true||raw.verified_source===true,commerce_error:result.error||raw.error||null}}];"
      },
      "id": "12",
      "name": "Normalize Woo Order Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const o=$json.woo_order;\nconst s=$json.owner_scope||{};\nif(!o){ return [{json:{...$json,owner_match:false,order_found:false,owner_match_reason:'not_found'}}]; }\nconst wcCustomer=o.customer_id!=null?Number(o.customer_id):null;\nconst billing=o.billing||{};\nconst orderEmail=String(billing.email||'').trim().toLowerCase()||null;\nconst orderPhone=String(billing.phone||'').replace(/[^0-9+]/g,'')||null;\nconst byCustomer=Boolean(s.customer_id && wcCustomer && Number(s.customer_id)===wcCustomer);\nconst byEmail=Boolean(s.verified_email && orderEmail && s.verified_email===orderEmail);\nconst byPhone=Boolean(s.verified_phone && orderPhone && s.verified_phone===orderPhone);\nconst ownerMatch=byCustomer||byEmail||byPhone;\nreturn [{json:{...$json,order_found:true,owner_match:ownerMatch,owner_match_reason:byCustomer?'customer_id':byEmail?'verified_email':byPhone?'verified_phone':'no_match'}}];"
      },
