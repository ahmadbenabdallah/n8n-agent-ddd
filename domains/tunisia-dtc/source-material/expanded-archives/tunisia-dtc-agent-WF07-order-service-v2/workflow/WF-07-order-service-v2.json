    {
      "parameters": {
        "jsCode": "return [{json:{message_id:$json.message_id||null,conversation_id:$json.conversation_id||null,route:'escalation',safe_to_reply:false,tools_allowed:false,execution_allowed:false,llm_allowed:false,reason:'invalid_or_unsupported_order_request'}}];"
