    },
    {
      "parameters": {
        "jsCode": "return [{json:{...$json,route:'clarification',verification_required:true,tools_allowed:false,execution_allowed:false,llm_allowed:true,safe_to_reply:true,reason:'order_verification_required'}}];"
      },
      "id": "7",
      "name": "Require Verification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -800,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const state=$json.state||{};\nconst orderId=String($json.order_id||state.order_id||'').trim();\nconst fields=['id','number','status','date_created','date_modified','customer_id','billing','shipping','line_items','shipping_lines','coupon_lines','meta_data'];\nlet operation='get_customer_orders';\nlet lookup={owner_scope:$json.owner_scope,limit:5,orderby:'date',order:'desc',include_sensitive:false};\nif(orderId){\n  if(!/^\\d{1,12}$/.test(orderId)) {\n    return [{json:{...$json,lookup_valid:false,reason:'invalid_order_id_format'}}];\n  }\n  operation='get_order';\n  lookup={order_id:Number(orderId),fields,include_sensitive:false};\n}\nreturn [{json:{...$json,lookup_valid:true,commerce_request:{operation,resource:'order',lookup},commerce_gateway:'WF-20'}}];"
      },
