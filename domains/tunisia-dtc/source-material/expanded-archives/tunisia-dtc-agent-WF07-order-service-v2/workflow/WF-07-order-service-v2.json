        -1200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const id=$json.identity||{};\nconst level=id.level||'anonymous';\nconst customerId=id.woocommerce_customer_id ?? id.customer_id ?? null;\nconst email=(id.verified_email||'').trim().toLowerCase()||null;\nconst phone=(id.verified_phone||'').replace(/[^0-9+]/g,'')||null;\nconst authorized=['order_verified','high_assurance'].includes(level);\nconst scope={\n  customer_id: customerId ? Number(customerId) : null,\n  verified_email: email,\n  verified_phone: phone\n};\nconst scopePresent=Boolean(scope.customer_id||scope.verified_email||scope.verified_phone);\nreturn [{json:{...$json,identity_level:level,authorized,owner_scope:scope,owner_scope_present:scopePresent}}];"
      },
      "id": "5",
      "name": "Build Trusted Owner Scope",
      "type": "n8n-nodes-base.code",
