    {
      "parameters": {
        "jsCode": "const o=$json.woo_order||{};\nconst status=String(o.status||'unknown');\nconst fulfillmentMap={pending:'pending',processing:'processing','on-hold':'on_hold',completed:'completed',cancelled:'cancelled',refunded:'refunded',failed:'failed',trash:'unknown'};\nconst items=Array.isArray(o.line_items)?o.line_items.map(x=>({product_id:x.product_id??null,variation_id:x.variation_id??null,name:String(x.name||'').slice(0,160),quantity:Number(x.quantity||0)})):[];\nconst trackingMeta=Array.isArray(o.meta_data)?o.meta_data.filter(m=>/tracking/i.test(String(m.key||''))).slice(0,5):[];\nconst trackingUrl=trackingMeta.map(m=>m.value).find(v=>typeof v==='string'&&/^https?:\\/\\//i.test(v))||null;\nconst safe={order_id:o.id??null,order_number:o.number??null,status,fulfillment_status:fulfillmentMap[status]||'unknown',created_at:o.date_created||null,updated_at:o.date_modified||null,currency:o.currency||null,total:o.total||null,items_summary:items,shipping_method:Array.isArray(o.shipping_lines)?o.shipping_lines.map(s=>String(s.method_title||s.method_id||'')).filter(Boolean).slice(0,3):[],tracking_available:Boolean(trackingUrl),tracking_url:trackingUrl};\nreturn [{json:{...$json,verified_order_data:safe,route:'support',tools_allowed:false,execution_allowed:false,llm_allowed:true,safe_to_reply:true,reason:null}}];"
      },
      "id": "16",
      "name": "Sanitize Verified Order",
