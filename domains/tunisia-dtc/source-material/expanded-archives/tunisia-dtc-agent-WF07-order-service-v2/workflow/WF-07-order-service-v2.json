      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.authorized && $json.owner_scope_present}}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "6",
      "name": "Order Access Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -1000,
