    {
      "parameters": {
        "jsCode": "const i=$json;\nconst required=['message_id','conversation_id','identity','intent'];\nconst missing=required.filter(k=>i[k]===undefined||i[k]===null);\nconst intentOk=i.intent==='order_status';\nreturn [{json:{...i,input_valid:missing.length===0&&intentOk,missing_fields:missing,intent_supported:intentOk}}];"
      },
