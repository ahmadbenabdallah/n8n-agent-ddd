        "jsCode": "const i=$json; const required=['message_id','conversation_id','llm_proposal','identity','security','state']; const missing=required.filter(k=>i[k]===undefined); return [{json:{...i,input_valid:missing.length===0,missing_fields:missing}}];"
      },
      "id": "2",
      "name": "Validate Action Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1700,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
