        -1300,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const p=$json.llm_proposal||{}; const a=p.action_proposal||{}; const allowed=['none','cart_add','cart_remove','cart_update','cart_clear','checkout_start','checkout_confirm']; const action=typeof a.action==='string'?a.action:'none'; return [{json:{...$json,action,action_parameters:a.parameters&&typeof a.parameters==='object'?a.parameters:{},action_allowlisted:allowed.includes(action)}}];"
      },
      "id": "5",
      "name": "Action Allowlist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1300,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.action_allowlisted}}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "6",
      "name": "Action Allowlisted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -1080,
        0
      ]
    },
    {
