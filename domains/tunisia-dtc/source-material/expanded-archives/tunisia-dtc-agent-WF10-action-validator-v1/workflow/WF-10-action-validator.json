      "id": "7",
      "name": "Deny Unknown Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -860,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const id=$json.identity||{}; const level=id.level||'anonymous'; const rules={none:['anonymous','channel_linked','order_verified','high_assurance'],cart_add:['channel_linked','order_verified','high_assurance'],cart_remove:['channel_linked','order_verified','high_assurance'],cart_update:['channel_linked','order_verified','high_assurance'],cart_clear:['channel_linked','order_verified','high_assurance'],checkout_start:['channel_linked','order_verified','high_assurance'],checkout_confirm:['order_verified','high_assurance']}; const permitted=(rules[$json.action]||[]).includes(level); return [{json:{...$json,identity_level:level,identity_permitted:permitted,required_identity_level:($json.action==='checkout_confirm'?'order_verified':'channel_linked')}}];"
      },
      "id": "8",
      "name": "Identity Permission Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -860,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.identity_permitted}}",
              "operation": "isTrue"
            }
          ]
        }
      },
