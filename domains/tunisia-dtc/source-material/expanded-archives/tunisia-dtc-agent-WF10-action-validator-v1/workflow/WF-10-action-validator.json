      "parameters": {
        "jsCode": "return [{json:{contract_version:'1.0.0',message_id:$json.message_id,conversation_id:$json.conversation_id,action:$json.action,parameters:$json.action_parameters,identity_level:$json.identity_level,required_identity_level:$json.required_identity_level,idempotency_key:$json.idempotency_key,risk_level:$json.risk_level,authorization:'allow',execution_allowed:true,execution_verified:false,reason:null}}];"
      },
