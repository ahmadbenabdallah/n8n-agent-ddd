      },
      "id": "19",
      "name": "Deny Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const highRisk=['checkout_confirm']; const security=$json.security||{}; const risk=$json.action==='checkout_confirm'?'high':($json.action==='cart_clear'?'medium':'low'); const securityBlocked=security.security_decision==='block'||security.security_decision==='escalate'; return [{json:{...$json,risk_level:risk,risk_pass:!securityBlocked,security_blocked:securityBlocked,validator_decision:securityBlocked?'deny':'allow'}}];"
      },
      "id": "20",
      "name": "Risk + Security Gate",
