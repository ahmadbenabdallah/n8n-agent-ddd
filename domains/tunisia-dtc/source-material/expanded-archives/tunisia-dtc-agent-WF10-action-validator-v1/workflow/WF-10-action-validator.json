    },
    {
      "parameters": {
        "jsCode": "const stage=$json.state?.stage||'NEW'; const a=$json.action; const blocked=(a==='checkout_confirm'&&!['CHECKOUT_READY','PRODUCT_SELECTED','CART_BUILDING'].includes(stage)) || (a==='checkout_start'&&!['CART_BUILDING','PRODUCT_SELECTED','CONSIDERING'].includes(stage)); return [{json:{...$json,business_rules_pass:!blocked,business_rule_error:blocked?'invalid_stage_for_action':null}}];"
      },
