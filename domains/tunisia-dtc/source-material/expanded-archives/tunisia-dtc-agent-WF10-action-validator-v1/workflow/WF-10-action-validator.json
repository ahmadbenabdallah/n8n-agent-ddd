    },
    {
      "parameters": {
        "jsCode": "const action=$json.action; const key=[$json.conversation_id,$json.message_id,action,JSON.stringify($json.action_parameters||{})].join(':'); const prior=$json.idempotency_record; const duplicate=prior?.status==='executed'&&prior?.key===key; return [{json:{...$json,idempotency_key:key,duplicate_execution:duplicate}}];"
      },
      "id": "17",
      "name": "Idempotency Check",
