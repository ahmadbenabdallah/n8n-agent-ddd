      "name": "Identity Permitted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -620,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{...$json,authorization:'deny',execution_allowed:false,reason:'insufficient_identity'}}];"
      },
      "id": "10",
      "name": "Deny Insufficient Identity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const p=$json.action_parameters||{}; const errors=[]; if(['cart_add','cart_remove','cart_update'].includes($json.action)&&!($json.state?.selected_product_id||p.product_id)) errors.push('product_id_required'); if($json.action==='cart_update' && !p.variant && !p.quantity) errors.push('update_parameter_required'); if($json.action==='cart_add' && p.quantity!==undefined && (!Number.isInteger(p.quantity)||p.quantity<1||p.quantity>20)) errors.push('invalid_quantity'); if(p.url && typeof p.url==='string' && !/^https:\\/\\//i.test(p.url)) errors.push('invalid_url'); return [{json:{...$json,parameter_valid:errors.length===0,parameter_errors:errors}}];"
      },
      "id": "11",
      "name": "Validate Action Parameters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        0
      ]
    },
    {
