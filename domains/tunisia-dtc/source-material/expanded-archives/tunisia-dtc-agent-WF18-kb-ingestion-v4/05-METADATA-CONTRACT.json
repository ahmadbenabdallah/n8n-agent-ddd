{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WF18KnowledgeChunkMetadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "document_version",
    "chunk_id",
    "classification",
    "language",
    "script",
    "approval_status",
    "content_hash"
  ],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "document_version": {"type": "string", "minLength": 1},
    "chunk_id": {"type": "string", "minLength": 1},
    "section": {"type": "string"},
    "classification": {"type": "string"},
    "language": {"type": "string"},
    "script": {"type": "string"},
    "approval_status": {
      "enum": ["DRAFT", "REVIEW", "APPROVED", "PUBLISHED", "SUPERSEDED", "REJECTED", "QUARANTINED"]
    },
    "effective_from": {"type": "string", "format": "date-time"},
    "effective_until": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "minLength": 1},
    "chunk_index": {"type": "integer", "minimum": 0},
    "source_trust_class": {"type": "string"}
  }
}