  "required": [
    "channel",
    "language",
    "script",
    "register",
    "customer_message"
  ],
  "properties": {
    "channel": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "script": {
      "type": "string"
    },
    "register": {
      "type": "string"
    },
    "customer_message": {
      "type": "string",
      "minLength": 1
    }
  }
}
