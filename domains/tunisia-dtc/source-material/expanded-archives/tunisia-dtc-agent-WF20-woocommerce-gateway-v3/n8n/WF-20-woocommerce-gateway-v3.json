    {
      "parameters": {
        "jsCode": "const x=$json;\nconst original=$items('Validate Gateway Contract',0,0)[0].json;\nconst op=original.gateway_operation;\nif(x.error && !x.statusCode) {\n  return [{json:{success:false,request_id:original.request_id,gateway_operation:op,\n    error_code:'woocommerce_gateway_error',error_message:String(x.error)}}];\n}\nlet data=x;\nif(Array.isArray(x.body)) data=x.body;\nelse if(x.body!==undefined) data=x.body;\n\nif(op==='health') return [{json:{success:true,request_id:original.request_id,gateway_operation:op,healthy:true}}];\n\nif(op==='coupon_validate'){\n const coupon=Array.isArray(data)?data[0]:data;\n if(!coupon || !coupon.id) return [{json:{success:true,request_id:original.request_id,gateway_operation:op,\n   coupon_validation:{code:original.code,eligible:false,reason_code:'coupon_not_found'}}}];\n return [{json:{success:true,request_id:original.request_id,gateway_operation:op,\n   coupon_validation:{code:coupon.code,eligible:true,discount_type:coupon.discount_type,\n   discount_amount:coupon.amount,free_shipping:coupon.free_shipping===true,\n   reason_code:'coupon_found',raw_rules:{\n     minimum_amount:coupon.minimum_amount,maximum_amount:coupon.maximum_amount,\n     usage_limit:coupon.usage_limit,usage_limit_per_user:coupon.usage_limit_per_user,\n     individual_use:coupon.individual_use,product_ids:coupon.product_ids,\n     excluded_product_ids:coupon.excluded_product_ids,product_categories:coupon.product_categories,\n     excluded_product_categories:coupon.excluded_product_categories,email_restrictions:coupon.email_restrictions,\n     date_expires:coupon.date_expires\n   }}}}];\n}\nif(op==='get_product'||op==='get_variation') {\n return [{json:{success:true,request_id:original.request_id,gateway_operation:op,product:data}}];\n}\nif(op==='get_products') return [{json:{success:true,request_id:original.request_id,gateway_operation:op,products:Array.isArray(data)?data:[]}}];\nif(op==='get_order') return [{json:{success:true,request_id:original.request_id,gateway_operation:op,order:data}}];\nif(op==='create_cod_order') return [{json:{success:true,request_id:original.request_id,gateway_operation:op,order:data}}];\nif(op==='update_order_status') return [{json:{success:true,request_id:original.request_id,gateway_operation:op,order:data}}];\nif(op.startsWith('cart_')) return [{json:{success:true,request_id:original.request_id,gateway_operation:op,cart:data}}];\nif(op==='checkout_validate') return [{json:{success:true,request_id:original.request_id,gateway_operation:op,\n checkout_validation:{valid:true,cart:data}}}];\nif(op==='transaction_preflight') return [{json:{success:true,request_id:original.request_id,gateway_operation:op,\n valid:true,validation:data}}];\nreturn [{json:{success:false,request_id:original.request_id,error_code:'unsupported_normalization'}}];"
      },
      "id": "normalize",
      "name": "Normalize Gateway Result",
