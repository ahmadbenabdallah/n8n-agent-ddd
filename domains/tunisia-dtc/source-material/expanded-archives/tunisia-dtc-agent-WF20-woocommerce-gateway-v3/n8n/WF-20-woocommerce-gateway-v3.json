    {
      "parameters": {
        "jsCode": "const x=$json;\nconst ops=[\n 'get_product','get_products','get_variation',\n 'get_order','create_cod_order','update_order_status',\n 'coupon_validate','cart_view','cart_add','cart_remove','cart_update','cart_clear',\n 'checkout_validate','transaction_preflight','health'\n];\nif(!ops.includes(x.gateway_operation)) throw new Error('WF-20 operation not allowed');\nif(!x.request_id) throw new Error('request_id required');\n\nconst idOps=['get_product','get_order','get_variation','update_order_status'];\nif(idOps.includes(x.gateway_operation) && x.gateway_operation!=='health' && x.gateway_operation!=='get_product' && x.gateway_operation!=='get_variation' && !x.order_id && x.gateway_operation==='get_order') throw new Error('order_id required');\n\nif(['cart_add','cart_remove','cart_update','cart_clear','cart_view','checkout_validate'].includes(x.gateway_operation) && !x.cart_reference) {\n  throw new Error('cart_reference required');\n}\n\nreturn [{json:{\n  ...x,\n  request_id:String(x.request_id),\n  gateway_version:'3.0',\n  received_at:new Date().toISOString()\n}}];"
      },
      "id": "validate",
