        "jsCode": "const r=$json;\nif(r.success!==true) return [{json:r}];\nconst op=r.gateway_operation;\nif(op==='create_cod_order' && r.order?.set_paid===true) {\n  return [{json:{...r,success:false,error_code:'invalid_paid_state_for_cod',order:null}}];\n}\nreturn [{json:{...r,verified_gateway:true}}];"
      },
