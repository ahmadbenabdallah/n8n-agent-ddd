{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DTC Agent Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response",
    "language",
    "intent",
    "decision",
    "escalation",
    "actions"
  ],
  "properties": {
    "response": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "tn",
        "ar",
        "fr",
        "en",
        "mixed",
        "unknown"
      ]
    },
    "intent": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "answer",
        "clarify",
        "escalate",
        "action"
      ]
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "reason"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "requires_validation",
          "parameters"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "requires_validation": {
            "type": "boolean"
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          }
        }
      }
    },
    "state_suggestion": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
