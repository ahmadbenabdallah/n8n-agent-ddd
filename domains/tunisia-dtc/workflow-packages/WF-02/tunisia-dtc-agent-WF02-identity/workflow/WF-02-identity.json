{
  "name": "WF-02 — Identity",
  "nodes": [
    {
      "parameters": {},
      "id": "execute-workflow-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 2,
      "position": [
        -1400,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$json;\nconst s=x.security_contract??x.security??{};\nconst valid=s.status!==undefined && s.route!==undefined;\nreturn [{json:{...x,identity_input:{valid_security_contract:valid,security:s}}}];"
      },
      "id": "validate-security-contract",
      "name": "Validate Security Contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1180,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.identity_input?.security?.status !== 'reject' }}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "security-allows-identity?",
      "name": "Security Allows Identity?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -940,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{...$json,identity:{\n level:\"anonymous\",\n status:\"blocked\",\n verified:false,\n reason:\"security_gate_reject\",\n allowed_operations:[\"human_request\"],\n verification_required:false\n}}}];"
      },
      "id": "identity-blocked",
      "name": "Identity Blocked",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -700,
        -220
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$json;\nconst channel=String(x.channel??\"\");\nconst channelUserId=x.channel_user_id??null;\nconst hasChannelIdentity=Boolean(channel && channelUserId);\nreturn [{json:{...x,identity_input:{\n ...x.identity_input,\n channel,\n channel_user_id:channelUserId,\n has_channel_identity:hasChannelIdentity,\n external_identity_source:hasChannelIdentity?channel:\"none\"\n}}}];"
      },
      "id": "extract-channel-identity",
      "name": "Extract Channel Identity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -700,
        160
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.identity_input?.has_channel_identity === true }}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "channel-identity-present?",
      "name": "Channel Identity Present?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -440,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{...$json,identity:{\n level:\"anonymous\",\n status:\"unverified\",\n verified:false,\n verification_source:\"none\",\n allowed_operations:[\"public_information\"],\n verification_required:false,\n customer_record_id:null\n}}}];"
      },
      "id": "set-anonymous-identity",
      "name": "Set Anonymous Identity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        -20
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$json;\nconst context=x.identity_context??{};\nreturn [{json:{...x,identity_context:{\n channel_user_id:x.channel_user_id,\n channel:x.channel,\n linked_customer_id:context.linked_customer_id??null,\n order_verified:context.order_verified===true,\n high_assurance_verified:context.high_assurance_verified===true,\n verification_method:context.verification_method??null\n}}}];"
      },
      "id": "load-identity-context",
      "name": "Load Identity Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$json,c=x.identity_context??{};\nlet level=\"channel_linked\";\nlet verified=false;\nlet method=c.verification_method??\"channel_linked\";\nif(c.high_assurance_verified){level=\"high_assurance\";verified=true;}\nelse if(c.order_verified){level=\"order_verified\";verified=true;}\nelse if(c.linked_customer_id){level=\"channel_linked\";}\nreturn [{json:{...x,identity:{\n level,status:verified?\"verified\":\"unverified\",verified,\n verification_source:c.linked_customer_id?\"customer_identity_store\":\"channel\",\n verification_method:method,\n customer_record_id:c.linked_customer_id,\n allowed_operations: level===\"high_assurance\"\n   ? [\"public_information\",\"customer_profile\",\"order_read\",\"order_write\",\"cart_read\",\"cart_write\",\"checkout\"]\n   : level===\"order_verified\"\n   ? [\"public_information\",\"customer_profile\",\"order_read\",\"cart_read\",\"cart_write\"]\n   : level===\"channel_linked\"\n   ? [\"public_information\",\"customer_profile\",\"cart_read\",\"cart_write\"]\n   : [\"public_information\"]\n}}}];"
      },
      "id": "determine-identity-level",
      "name": "Determine Identity Level",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        60,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$json,t=String(x.text??\"\");\nconst sensitive=/(password|mot de passe|كلمة السر|otp|one[- ]time|cvv|cvc|card number|api key|access token)/i.test(t);\nconst orderClaim=/(order|commande|طلب).*(status|statut|وين|فين|where|address|delivery|livraison)/i.test(t);\nreturn [{json:{...x,identity_request_classification:{\n sensitive_verification_request:sensitive,\n order_or_private_request:orderClaim\n}}}];"
      },
      "id": "sensitive-verification-request?",
      "name": "Sensitive Verification Request?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$json,i=x.identity??{},c=x.identity_request_classification??{};\nlet permitted=i.allowed_operations??[\"public_information\"];\nlet needsVerification=false;\nlet deny=false;\nlet reason=null;\nif(c.sensitive_verification_request){\n deny=true; reason=\"authentication_or_secret_data_not_supported\";\n}\nif(c.order_or_private_request && ![\"order_verified\",\"high_assurance\"].includes(i.level)){\n needsVerification=true; deny=true; reason=\"higher_assurance_required\";\n}\nreturn [{json:{...x,identity_decision:{\n permitted_operations:permitted,\n needs_verification:needsVerification,\n deny,\n reason,\n minimum_necessary:true\n}}}];"
      },
      "id": "apply-minimum-necessary-access",
      "name": "Apply Minimum Necessary Access",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.identity_decision?.deny === true }}",
                    "rightValue": "true",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "deny"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.identity_decision?.needs_verification === true }}",
                    "rightValue": "true",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "verify"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.identity_decision?.deny === false && $json.identity_decision?.needs_verification === false }}",
                    "rightValue": "true",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "continue"
            }
          ]
        },
        "options": {}
      },
      "id": "identity-decision",
      "name": "Identity Decision",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{...$json,identity_result:{\n decision:\"deny\",\n allowed:false,\n reason:$json.identity_decision.reason,\n verification_required:false,\n never_request_secrets:true\n}}}];"
      },
      "id": "identity-denial",
      "name": "Identity Denial",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{...$json,identity_result:{\n decision:\"verify\",\n allowed:false,\n reason:$json.identity_decision.reason,\n verification_required:true,\n required_level:\"order_verified\",\n minimum_necessary:true\n}}}];"
      },
      "id": "verification-required",
      "name": "Verification Required",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{...$json,identity_result:{\n decision:\"continue\",\n allowed:true,\n identity_level:$json.identity.level,\n customer_record_id:$json.identity.customer_record_id,\n permitted_operations:$json.identity_decision.permitted_operations,\n verification_required:false\n}}}];"
      },
      "id": "identity-approved",
      "name": "Identity Approved",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "const x=$json;\nreturn [{json:{...x,identity_contract:{\n level:x.identity?.level??\"anonymous\",\n verified:x.identity?.verified??false,\n customer_record_id:x.identity?.customer_record_id??null,\n decision:x.identity_result?.decision??\"deny\",\n allowed:x.identity_result?.allowed??false,\n permitted_operations:x.identity_result?.permitted_operations??[\"public_information\"],\n verification_required:x.identity_result?.verification_required??false,\n never_request_secrets:true\n}}}];"
      },
      "id": "build-identity-contract",
      "name": "Build Identity Contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        300
      ]
    }
  ],
