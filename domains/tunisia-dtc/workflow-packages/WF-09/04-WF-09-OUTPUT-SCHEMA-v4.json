{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WF-09 LLM Reasoning Proposal v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "response",
    "intent",
    "decision",
    "actions",
    "escalation",
    "citations",
    "state_suggestion",
    "uncertainty"
  ],
  "properties": {
    "response": {
      "type": "string",
      "maxLength": 4000
    },
    "intent": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ANSWER",
        "CLARIFY",
        "PROPOSE_ACTION",
        "ESCALATE",
        "SAFE_ACK",
        "NO_ACTION"
      ]
    },
    "actions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "action_type",
          "parameters",
          "reason"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^act_[A-Za-z0-9_-]{1,80}$"
          },
          "action_type": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggested",
        "reason",
        "priority"
      ],
      "properties": {
        "suggested": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "priority": {
          "type": "string",
          "enum": [
            "LOW",
            "NORMAL",
            "HIGH",
            "URGENT"
          ]
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "state_suggestion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sales_stage": {
          "type": "string"
        },
        "sub_intent": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "script": {
          "type": "string"
        },
        "register": {
          "type": "string"
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "reason"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}