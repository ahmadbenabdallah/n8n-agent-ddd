{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WF16ResponseRendererOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "channel",
    "response_id",
    "conversation_id",
    "text",
    "language",
    "script",
    "register",
    "mode",
    "source_fact_ids",
    "rendered_action_ids",
    "privacy_filtered",
    "validation"
  ],
  "properties": {
    "channel": {"const": "messenger"},
    "response_id": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "language": {"type": "string"},
    "script": {"type": "string"},
    "register": {"type": "string"},
    "mode": {
      "enum": ["NORMAL", "SAFE_ONLY", "HUMAN_OWNED", "RECONCILIATION", "ERROR"]
    },
    "source_fact_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "rendered_action_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "privacy_filtered": {"type": "boolean"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "checks"],
      "properties": {
        "passed": {"type": "boolean"},
        "checks": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}