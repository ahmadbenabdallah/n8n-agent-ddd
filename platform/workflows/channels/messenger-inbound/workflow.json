{
  "name": "WF-00 — Inbound Gateway — Facebook Messenger",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "facebook-messenger/webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wf00-get-webhook",
      "name": "META Verify — GET",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1200,
        -300
      ],
      "webhookId": "facebook-messenger-webhook-get"
    },
    {
      "parameters": {
        "jsCode": "const q = $json.query ?? {};\nconst mode = String(q['hub.mode'] ?? '');\nconst token = String(q['hub.verify_token'] ?? '');\nconst challenge = String(q['hub.challenge'] ?? '');\n\nconst expected = String($env.META_VERIFY_TOKEN ?? '');\n\nif (mode !== 'subscribe') {\n  return [{ json: { ok: false, http_status: 400, reason: 'invalid_mode' } }];\n}\n\nif (!expected || token !== expected) {\n  return [{ json: { ok: false, http_status: 403, reason: 'invalid_verify_token' } }];\n}\n\nreturn [{ json: { ok: true, http_status: 200, challenge } }];"
      },
      "id": "wf00-verify-token",
      "name": "Validate Meta Verify Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        -300
      ]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.ok ? $json.challenge : $json.reason }}",
        "options": {}
      },
      "id": "wf00-get-response",
      "name": "Meta Verification Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        -700,
        -300
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "facebook-messenger/webhook",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "wf00-post-webhook",
      "name": "META Events — POST",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1200,
        200
      ],
      "webhookId": "facebook-messenger-webhook-post"
    },
    {
      "parameters": {
        "jsCode": "const headers = $json.headers ?? {};\nconst body = $json.body ?? {};\nconst signature = String(\n  headers['x-hub-signature-256'] ??\n  headers['X-Hub-Signature-256'] ??\n  ''\n);\n\nreturn [{\n  json: {\n    request: {\n      headers,\n      signature,\n      body,\n      received_at: new Date().toISOString()\n    },\n    binary_present: !!$binary?.data\n  },\n  binary: $binary\n}];"
      },
      "id": "wf00-capture-request",
      "name": "Capture Meta Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "/*\nProduction note:\nMeta signs the raw HTTP body with the Page/App secret.\nThis node deliberately FAILS CLOSED if signature material is unavailable.\n\nFor the final production implementation, connect the raw-body signature\nverification step here (Crypto/HMAC-SHA256 or an upstream verified proxy).\nDo not bypass this check merely to make the workflow pass.\n\nThe current workflow can be tested in development with signature verification\ndisabled only by explicitly setting ALLOW_UNVERIFIED_META_WEBHOOK=true.\n*/\nconst sig = String($json.request?.signature ?? '');\nconst allowDev = String($env.ALLOW_UNVERIFIED_META_WEBHOOK ?? '').toLowerCase() === 'true';\n\nif (!sig && !allowDev) {\n  return [{json:{...$json, security:{signature_valid:false, decision:'reject', reason:'missing_meta_signature'}}}];\n}\n\nreturn [{\n  json:{\n    ...$json,\n    security:{\n      signature_valid: allowDev ? null : 'PENDING_HMAC_VALIDATION',\n      decision: allowDev ? 'development_only_accept' : 'pending'\n    }\n  }\n}];"
      },
      "id": "wf00-signature-gate",
      "name": "Meta Signature Security Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -700,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.security?.decision === 'reject' }}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "wf00-reject-signature",
      "name": "Reject Invalid Signature",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -440,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"received\":false,\"error\":\"webhook_signature_required\"}",
        "options": {
          "responseCode": 403
        }
      },
      "id": "wf00-reject-response",
      "name": "403 Signature Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        -180,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const event = $json.request?.body ?? {};\nconst entry = event.entry?.[0] ?? {};\nconst messaging = entry.messaging?.[0] ?? {};\nconst message = messaging.message ?? {};\n\nconst senderId = messaging.sender?.id ?? null;\nconst recipientId = messaging.recipient?.id ?? entry.id ?? null;\nconst messageId = message.mid ?? null;\nconst text = typeof message.text === 'string' ? message.text : '';\n\nconst messageType =\n  message.text ? 'text' :\n  message.attachments ? 'attachment' :\n  messaging.postback ? 'postback' :\n  messaging.reaction ? 'reaction' :\n  'unknown';\n\nif (!senderId || !messageId) {\n  return [{\n    json: {\n      accepted: false,\n      reject_reason: 'missing_sender_or_message_id',\n      channel: 'facebook_messenger',\n      raw_event: event\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    accepted: true,\n    channel: 'facebook_messenger',\n    channel_user_id: String(senderId),\n    page_id: String(recipientId),\n    message_id: String(messageId),\n    conversation_id: `facebook_messenger:${senderId}`,\n    text,\n    message_type: messageType,\n    timestamp: messaging.timestamp ?? Date.now(),\n    is_echo: Boolean(message.is_echo),\n    postback: messaging.postback ?? null,\n    attachments: message.attachments ?? [],\n    raw_event: event,\n    source_trust: 'untrusted',\n    received_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "wf00-normalize",
      "name": "Normalize Messenger Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        280
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.accepted === true && $json.is_echo !== true }}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "wf00-accepted",
      "name": "Accepted Customer Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        100,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "const x = $json;\nreturn [{\n  json: {\n    ...x,\n    idempotency_key: `${x.channel}:${x.message_id}`,\n    processing: {\n      stage: 'INBOUND_NORMALIZED',\n      idempotency_required: true,\n      language_detection: 'WF-03-or-language-detector',\n      security_classification: 'WF-01',\n      identity_resolution: 'WF-02',\n      state_resolution: 'WF-03',\n      intent_resolution: 'WF-04'\n    }\n  }\n}];"
      },
      "id": "wf00-canonical",
      "name": "Build Canonical Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        280
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.text }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "wf00-text-check",
      "name": "Text Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        620,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    ...$json,\n    next_workflow: 'WF-01-security-gate',\n    route_type: 'customer_message'\n  }\n}];"
      },
      "id": "wf00-route-security",
      "name": "Route to Security Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{\n  json: {\n    ...$json,\n    next_workflow: 'WF-01-security-gate',\n    route_type: 'non_text_event'\n  }\n}];"
      },
      "id": "wf00-route-nontext",
      "name": "Route Non-Text Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        380
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"received\":true,\"accepted\":true,\"message_id\":$json.message_id}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "wf00-post-response",
      "name": "Messenger ACK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1140,
        280
      ]
    }
  ],
