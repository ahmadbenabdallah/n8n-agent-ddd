{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://n8n-agent-ddd.dev/schemas/task.schema.json",
  "title": "n8n-agent-ddd Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "goal", "lifecycle", "acceptance", "tests", "dependencies"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "lifecycle": {
      "type": "string",
      "enum": [
        "DISCOVER",
        "DEFINE",
        "DOMAIN",
        "SPECIFY",
        "ARCHITECT",
        "DESIGN",
        "DECOMPOSE",
        "PLAN",
        "IMPLEMENT",
        "TEST",
        "SECURITY",
        "REVIEW",
        "INTEGRATE",
        "DEPLOY",
        "VERIFY",
        "OPERATE",
        "LEARN"
      ]
    },
    "domain": { "type": "string" },
    "scope": { "type": "object" },
    "requirements": { "type": "array", "items": { "type": "string" } },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "security": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]+$" }
    },
    "worktree": {
      "type": "object",
      "properties": { "required": { "type": "boolean" }, "branch": { "type": "string" } },
      "additionalProperties": false
    }
  }
}
