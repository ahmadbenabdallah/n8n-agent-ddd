{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["executionId", "agentId", "capabilityId", "decision", "timestamp"],
  "properties": {
    "executionId": {
      "type": "string"
    },
    "agentId": {
      "type": "string"
    },
    "capabilityId": {
      "type": "string"
    },
    "kind": {
      "enum": ["skill", "tool", "plugin", "mcp"]
    },
    "decision": {
      "enum": ["allowed", "denied"]
    },
    "policyIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domainId": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  }
}
