{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "reconciliationId",
    "operationId",
    "state",
    "timestamp"
  ],
  "properties": {
    "reconciliationId": {
      "type": "string"
    },
    "operationId": {
      "type": "string"
    },
    "state": {
      "enum": [
        "UNKNOWN",
        "RECONCILING",
        "VERIFIED_NOT_EXECUTED",
        "VERIFIED_EXECUTED",
        "CONFLICT",
        "ESCALATED"
      ]
    },
    "externalReference": {
      "type": "string"
    },
    "evidence": {
      "type": "object"
    },
    "timestamp": {
      "type": "string"
    }
  }
}